; Siemens A70 / A75 (PMB7860) -- AllBoot
; Test point loaders
;
; A70: Spansion 4MB flash (0xC00000), writefix v6 (DQ7 polling)
; A75: 8MB flash (0x800000)
;
; Common: PMB7860 CPU, UART PP3/F040, 26MHz

[PhoneCommonInfo]
Version=2.1
Comments=AllBoot loaders for Siemens A70 / A75 (PMB7860)
Copyright=ufoshko
ReleaseDate=2026-09-25
Name=A70 / A75

MCUMemGeometry=0x000000: 0x010000

optInfoCmdDisable=0
optBaudCmdDisable=0
optBaudCmdCodes=57600: 0x00, 115200: 0x01, 460800: 0x03, 921600: 0x04
optReadCmdSkipBytesAfterData=0
optReadCmdSkipBytesAfterCheckSum=2


[Phone01]
Name=A70
Type=Test point
Comments=Siemens A70 (PMB7860, Spansion 4MB, writefix v6 DQ7 polling)
MCUMemFuBu=   fullflash, 0xC00000, 0x400000
MCUMemFlashBase=0xC00000
MCUMemArea01= bootcore,  0xC00000, 0x020000, bootcore
MCUMemArea02= eeprom,    0xFA0000, 0x060000
Boots=Connect, ServiceBoot_A70.bin, AllBoot_A70.bin

[Phone02]
Name=A75
Type=Test point
Comments=Siemens A75 (PMB7860, 8MB flash)
MCUMemFuBu=   fullflash, 0x800000, 0x800000
MCUMemFlashBase=0x800000
MCUMemArea01= bootcore,  0x800000, 0x020000, bootcore
MCUMemArea02= eeprom,    0xFA0000, 0x060000
Boots=Connect, ServiceBoot_A75.bin, AllBoot_A75.bin


; ============================================================
;  Boots
; ============================================================

[Boot01]
Name=Connect
UseIgnition=1
TryCount=-1
NoSendLen=1
NoSendCheckSum=1
PortSpeed=57600
Data=55
Answer=A0


; --- A70 ---

[Boot02]
Name=ServiceBoot_A70.bin
SizeLen=1
AnswerTimeout=3000

Answer=A555

[Boot03]
Name=AllBoot_A70.bin
SizeLen=2
AnswerTimeout=15000

Answer=0sOK


; --- A75 ---

[Boot04]
Name=ServiceBoot_A75.bin
SizeLen=1
AnswerTimeout=3000

Answer=A555

[Boot05]
Name=AllBoot_A75.bin
SizeLen=2
AnswerTimeout=15000

Answer=0sOK
