; Loaders for the pmb887x-emu emulator (https://github.com/siemens-mobile-hacks/pmb887x-emu).
;
; The emulated boot ROM of the SGOLD2 devices answers "AT" with 0xC0
; (NewSGOLD) instead of the SGOLD 0xB0; the service loader is then uploaded
; over the boot ROM protocol (0x30 + [size:2][data][xor]) and answers 0xC1,
; followed by the 0xA5 ACK of the loaded loader. Two loader flavors are
; needed (both from the emulator bsp, built with its boot/Makefile):
;
;  - EL71 (the "elka"/x85 family): boot/chaos_x85.S, the chaos loader.
;  - S75 (the x75 family): boot/pv_boot_x85.S, the PV loader, which needs
;    the extra 0x55->0xAA init handshake after the upload.
;
; Both loaders speak the chaos x65-family protocol afterwards: 4-byte
; absolute addressing, the v2 write command, [data]["OK"][xor16] read
; answers and the 128-byte v3 flash info (all 0xFF on the PV loader - the
; S75 phone below therefore carries an explicit MCUMemGeometry).

[PhoneCommonInfo]
Version		= 1.0
Comments	= pmb887x-emu (EL71, S75) over the TCP serial chardev
Name		= pmb887x-emu

MCUMemGeometry	= 0

optBaudCmdCodes				= 57600: 0x00, 115200: 0x01, 230400: 0x02, 460800: 0x03, 614400: 0x04, 921600: 0x05, 1228800: 0x06, 1600000: 0x07, 1500000: 0x08, 3250000: 0x09
optCmdAddrAndSizeLen			= 4
optWriteCmdVersion			= 2
optKeepAliveCmdEnableAndSetInterval	= 250

[Phone01]
Name		= EL71
Type		= Chaos x85
Comments	= The pmb887x-emu siemens-el71 device with the chaos_x85 loader
Boots		= Connect, GoBoot, ChaosBoot_x85
MCUMemFuBu	= fullflash,        0xA0000000, 0x04000000

[Phone02]
Name		= S75
Type		= PV x75
Comments	= The pmb887x-emu siemens-s75 device with the pv_boot_x85 loader
Boots		= Connect, GoBoot, PVBoot_x85, PVInit
; The erase-block layout of the two emulated flash chips (the PV loader
; reports no flash info, so the geometry is explicit here): FLASH0 is the
; Intel 128Mbit 880D with the 4x32K top boot blocks at 0xA1FE0000, FLASH1
; is the 881C with the 4x32K bottom boot blocks at 0xA2000000; the rest is
; 128K sectors.
MCUMemGeometry	= 0xA0000000: 0x020000, 0xA1FE0000: 0x008000, 0xA2000000: 0x008000, 0xA2020000: 0x020000

[Boot01]
Name		= Connect
TryCount	= -1
NoSendLen	= 1
Data		= 0sAT
NoSendCheckSum	= 1
Answer		= C0
AnswerTimeout	= 100

[Boot02]
Name		= GoBoot
NoSendLen	= 1
Data		= 30
NoSendCheckSum	= 1

[Boot03]
Name		= ChaosBoot_x85
SizeLen		= 2
Data		= 
Answer		= C1A5

[Boot04]
Name		= PVBoot_x85
SizeLen		= 2
Data		= 
Answer		= C1A5

[Boot05]
Name		= PVInit
NoSendLen	= 1
Data		= 55
NoSendCheckSum	= 1
Answer		= AA
