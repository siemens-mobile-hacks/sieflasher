{
	"name": "@sie-js/flasher",
	"version": "0.1.0",
	"description": "Siemens phone flasher core: a reimplementation of the V_KLay flasher for the old Siemens phones, for the browser (WebSerial) and Node.js.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./web": "./dist/web/transport.js",
		"./package.json": "./package.json"
	},
	"files": [
		"./dist/*"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch",
		"prepare": "tsc -p tsconfig.json",
		"test": "node scripts/run-tests.mjs"
	},
	"license": "MIT",
	"repository": {
		"url": "git+https://github.com/siemens-mobile-hacks/sieflasher.git",
		"directory": "core"
	},
	"dependencies": {
		"@sie-js/serial": "^1.1.17",
		"@sie-js/vkp": "^2.0.2",
		"debug": "^4.4.3",
		"sprintf-js": "^1.1.3"
	},
	"devDependencies": {
		"@types/debug": "^4.1.12",
		"@types/node": "^22.19.15",
		"@types/sprintf-js": "^1.1.4",
		"typescript": "^5.9.3"
	}
}
